# Senha para entrar no sistema (obrigatória na Vercel)
APP_PASSWORD=troque-esta-senha

# Preenchidas automaticamente pela Vercel ao conectar o Upstash Redis
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Preenchida automaticamente pela Vercel ao conectar o Blob
BLOB_READ_WRITE_TOKEN=

# Sem essas variáveis, rodando no seu computador (npm run dev),
# os relatórios ficam salvos na pasta .data/ e as fotos dentro do próprio relatório.
